APP_NAME="SIMD Cryptography"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_BASE_URL=
SESSION_SECURE_COOKIE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simd_cryptography
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# File private/public key dibuat oleh: php bin/generate-keys.php
RSA_PUBLIC_KEY_PATH=storage/keys/public.pem
RSA_PRIVATE_KEY_PATH=storage/keys/private.pem
RSA_PRIVATE_KEY_PASSPHRASE=GANTI_DENGAN_PASSPHRASE_KUNCI_YANG_KAMU_BUAT
