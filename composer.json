{
  "name": "rifrain/simd-hybrid-cryptography",
  "description": "Sistem Informasi Manajemen Dokumen dengan Hybrid Cryptography AES-256-GCM dan RSA-OAEP SHA-256",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "phpseclib/phpseclib": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
